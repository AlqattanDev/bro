#!/usr/bin/env bash
# Animate the tmux status word once a second.
set -euo pipefail
BRO_HOME="${BRO_HOME:-$HOME/.bro}"
STATE="${BRO_STATE_DIR:-$BRO_HOME/state}"
FRAME="$STATE/status-frame"
PAINT="$BRO_HOME/bin/bro-status-paint"
n=0
SOCKET="${BRO_TMUX_SOCKET:-bro}"
VOX_STATE="${VOX_STATE:-$HOME/.vox/state/state.json}"
WORD="$STATE/status-word"
OWNER="$STATE/status-owner"
BACKEND_WORD="$STATE/status-backend-word"
INTERVAL="${BRO_STATUS_INTERVAL:-0.25}"
mkdir -p "$STATE"
[[ -f "$WORD" ]] || echo ready >"$WORD"

# What the backend last said about itself ("working" survives a voice turn).
# A "starting" that never lands is a boot that failed: after the timeout the
# honest word is down, and bro-shell's retry loop rewrites starting (and its
# mtime) on every attempt, so a retrying backend flips back on its own.
backend_word() {
  local w age now
  w="$(tr -d '[:space:]' 2>/dev/null <"$BACKEND_WORD" || true)"
  case "$w" in
    working|down) echo "$w" ;;
    starting)
      now="$(date +%s)"
      age=$(( now - $(stat -f %m "$BACKEND_WORD" 2>/dev/null || echo 0) ))
      if (( age > ${BRO_STARTING_TIMEOUT:-60} )); then
        echo down
      else
        echo starting
      fi
      ;;
    *) echo ready ;;
  esac
}

# Restore the bar to the backend's own state once vox is quiet.
settle() {
  local w owner age now
  # A fresh hint (e.g. bro-talk's "listening" set just before the mic truly
  # opens) outruns the vox state file — honour it for a few seconds instead
  # of flapping back to ready.
  owner="$(tr -d '[:space:]' 2>/dev/null <"$OWNER" || echo idle)"
  if [[ "$owner" == hint ]]; then
    now="$(date +%s)"
    age=$(( now - $(stat -f %m "$WORD" 2>/dev/null || echo 0) ))
    (( age <= 3 )) && return
  fi
  w="$(backend_word)"
  echo "$w" >"$WORD"
  if [[ "$w" == ready ]]; then
    echo idle >"$OWNER"
  else
    echo backend >"$OWNER"
  fi
}

while true; do
  vox_state=""
  mic_open="false"
  if [[ -f "$VOX_STATE" ]]; then
    vox_json="$(jq -r '[.state // "", (.microphone_open // false)] | @tsv' "$VOX_STATE" 2>/dev/null || true)"
    if [[ -n "$vox_json" ]]; then
      IFS=$'\t' read -r vox_state mic_open <<<"$vox_json"
    fi
  fi
  case "$vox_state" in
    speaking)
      echo speaking >"$WORD"
      echo vox >"$OWNER"
      ;;
    processing)
      echo working >"$WORD"
      echo vox >"$OWNER"
      ;;
    listening|idle|"")
      if [[ "$mic_open" == true ]]; then
        echo listening >"$WORD"
        echo vox >"$OWNER"
      else
        settle
      fi
      ;;
  esac

  echo "$n" >"$FRAME"
  "$PAINT" 2>/dev/null || true
  (tmux -L "$SOCKET" list-clients -F '#{client_name}' 2>/dev/null || true) | while read -r c; do
    tmux -L "$SOCKET" refresh-client -S -t "$c" 2>/dev/null || true
  done
  n=$(( (n + 1) % 10 ))
  sleep "$INTERVAL"
done
