#!/usr/bin/env bash
# Quiet loop: every few seconds, refresh the snapshot of your work pane.
set -euo pipefail

BRO_HOME="${BRO_HOME:-$HOME/.bro}"
INTERVAL="${BRO_WATCH_INTERVAL:-3}"

# PRIVACY: this loop captures the tmux pane ONLY. Screen capture is manual
# (F3 or an explicit ask). BRO_NO_SCREEN makes bro-snapshot refuse --screen for
# every process started from here, so no future edit can turn the timer into a
# camera by accident.
export BRO_NO_SCREEN=1

while true; do
  "$BRO_HOME/bin/bro-snapshot" >/dev/null 2>&1 || true
  sleep "$INTERVAL"
done
