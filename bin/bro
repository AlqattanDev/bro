#!/usr/bin/env bash
# bro — one front door: interactive session, or a quick non-interactive note.
#
# Usage:
#   bro                     start / attach the interactive session
#   bro <message>           send a note (answers on the F1 board)
#   bro quiet | call | ping status current mode
#   bro snapshot            read your pane into watch files, right now
#   bro read                look now and print what I see
#   bro stop                stop everything on purpose (detaching does not)
#   bro daemon ...          launchd LaunchAgent that owns the headless backend
#   bro backend [grok|claude|codex]
#   bro help
#
# Nothing here runs on a timer that looks at you: bro captures the pane only
# when it is asked to, and the screen only on F3 or an explicit ask.
set -euo pipefail

export BRO_HOME="${BRO_HOME:-$HOME/.bro}"
export BRO_SESSION="${BRO_SESSION:-bro}"
export BRO_TMUX_SOCKET="${BRO_TMUX_SOCKET:-bro}"
export PATH="$BRO_HOME/bin:$PATH"

SESSION="$BRO_SESSION"
CONF="$BRO_HOME/tmux.conf"
WATCH="$BRO_HOME/watch"
STATE="${BRO_STATE_DIR:-$BRO_HOME/state}"
MODE_FILE="$STATE/mode"
INBOX_TOOL="$BRO_HOME/bin/bro-inbox"
# Private socket so we never fight your other tmux sessions.
TMUXC=(tmux -L "$BRO_TMUX_SOCKET" -f "$CONF")

mkdir -p "$BRO_HOME"
cmd="${1:-start}"
usage() {
  cat <<'EOF'
bro — full-screen work + hidden agent + clean board

  bro                              Start or attach (interactive, default backend)
  bro <message>                    Send a note, non-interactive (answers on the F1 board)
  bro ask <message>                Same, but safe when <message> starts with a subcommand word
  bro quiet                        No voice
  bro call                         Voice, keep going
  bro ping                         One voice reply, then silent
  bro board                        Open the nvim board (edit / scroll the answer)
  bro show [--open|--close]        Toggle the floating answer panel (F1)
  bro summon <message>             Same as the ⌃§ hotkey: ask from anywhere, async
  bro summon voice                 Same as the ⌥§ hotkey: open the mic now
  bro remember <fact>              File a fact into long-term memory
  bro goal <text>                  Add a goal; bro steers briefs and nudges by it
  bro goals                        Show the goal list
  bro remind [list]                Show reminders
  bro remind '+30m' stretch        Remind me (WHEN: +Nm +Nh HH:MM YYYY-MM-DDTHH:MM)
  bro remind cancel <id>           Cancel one
  bro brief [HH:MM|off]            Morning brief now, or scheduled daily
  bro debrief [HH:MM|off]          Evening debrief now, or scheduled daily
  bro hotkeys                      Show the global summon keys in force
  bro speakers on|off|status       Cheap two-voice ID (off by default)
  bro status                       Show current talk mode
  bro --backend grok|claude|codex
  bro backend                      Show current backend
  bro backend claude               Set default backend (saved)
  bro snapshot                     Save your pane for bro
  bro read                         Look at your pane now and print what I see
  bro stop                         End everything (daemon, loops, bar, session)
  bro daemon install|uninstall     Run the backend at login under launchd
  bro daemon status|restart        (install is explicit — never automatic)
  bro doctor                       Check the whole machine story, ✓/✗ with fixes
  bro update                       Pull, test, rebuild, restart — the one ritual
  bro verify                       Keyboard checklist for what no test can reach
  bro help

Global keys (any app, no terminal needed — BroBar registers them):
  ⌥§   summon by voice — mic opens now, answer comes back in the panel
  ⌃§   summon by typing — a one-line field, Enter to send, Esc to cancel
       (rebind in ~/.bro/hotkeys; Vox keeps ⌘§)

Keys:
  F1   floating answer panel — over any app, never steals focus (click to dismiss)
  F2   your full-screen work
  F3   snapshot your screen
  F4   talk — mic opens now, do not wait

Commands run in YOUR terminal via bro-run (agent does this).
Explanations go on the F1 panel via bro-show; `bro board` opens the same text in nvim.

Watch / show:
  ~/.bro/watch/latest.md
  ~/.bro/show/current.md
  ~/.bro/state/backend    saved backend name
EOF
}

ensure_dirs() {
  mkdir -p "$WATCH" "$BRO_HOME/logs" "$STATE"
  migrate_state
}

# One-time move of the root-level singleton files into state/. Runs on every
# bro invocation; a no-op once nothing sits at the root any more. Never
# overwrites: a file that already exists in state/ is the live one.
migrate_state() {
  local f
  for f in status-word status-backend-word status-line status-frame \
           status-owner status-loop.pid bro-bar.pid daemon.pid \
           mode backend show-policy; do
    if [[ -f "$BRO_HOME/$f" && ! -e "$STATE/$f" ]]; then
      mv "$BRO_HOME/$f" "$STATE/$f" 2>/dev/null || true
    fi
  done
}

start_status_loop() {
  local pidfile="$STATE/status-loop.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    return 0
  fi
  nohup "$BRO_HOME/bin/bro-status-loop" >>"$BRO_HOME/logs/status.log" 2>&1 &
  echo $! >"$pidfile"
}

start_nudge_loop() {
  # The reminder timer. It only ever reads ~/.bro/reminders and the clock —
  # supervision identical to the status loop, philosophy intact.
  local pidfile="$STATE/nudge-loop.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    return 0
  fi
  nohup "$BRO_HOME/bin/bro-nudge-loop" >>"$BRO_HOME/logs/nudge.log" 2>&1 &
  echo $! >"$pidfile"
}

bro_bar_bin() {
  # Built by bin/build-bro-bar. Absent on a machine that never built it.
  printf '%s\n' "${BRO_BAR_BIN:-$BRO_HOME/dist/BroBar.app/Contents/MacOS/BroBar}"
}

start_bro_bar() {
  # The menu bar face. Same nohup+pidfile shape as the loops above, launching
  # the app's executable directly so the pid we record is the one we can kill.
  local bar
  bar="$(bro_bar_bin)"
  [[ -x "$bar" ]] || return 0
  local pidfile="$STATE/bro-bar.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    return 0
  fi
  nohup "$bar" >>"$BRO_HOME/logs/bro-bar.log" 2>&1 &
  echo $! >"$pidfile"
}

stop_bro_bar() {
  local pidfile="$STATE/bro-bar.pid"
  if [[ -f "$pidfile" ]]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile"
  fi
}

stop_daemon() {
  # Only a deliberate `bro stop` gets here. Detaching (Ctrl-a d, closing the
  # window) never runs this, which is the whole point of Phase 4.
  local d="$BRO_HOME/bin/bro-daemon"
  if [[ -x "$d" ]]; then
    "$d" stop >/dev/null 2>&1 || true
    return 0
  fi
  local pidfile="$STATE/daemon.pid"
  if [[ -f "$pidfile" ]]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile"
  fi
}

stop_loops() {
  # Phase 5 removed the watch loop; a machine upgrading mid-flight can still
  # have one running from before, so a deliberate stop reaps its pidfile too.
  local pidfile="$WATCH/watch.pid"
  if [[ -f "$pidfile" ]]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile"
  fi
  local spid="$STATE/status-loop.pid"
  if [[ -f "$spid" ]]; then
    kill "$(cat "$spid")" 2>/dev/null || true
    rm -f "$spid"
  fi
  local npid="$STATE/nudge-loop.pid"
  if [[ -f "$npid" ]]; then
    kill "$(cat "$npid")" 2>/dev/null || true
    rm -f "$npid"
  fi
}

backend_up() {
  # Everything bro *is* without a terminal: the status paint loop, the menu bar
  # face, and the detached tmux session holding the hidden backend. Safe to
  # call over and over — every start is pidfile-guarded — which is what lets
  # the daemon supervise it and a terminal merely join it.
  ensure_dirs
  # If Ali installed the LaunchAgent and something booted it out (a deliberate
  # `bro stop`, say), put launchd back in charge. Never installs anything.
  if [[ -z "${BRO_DAEMON:-}" && -x "$BRO_HOME/bin/bro-daemon" ]]; then
    "$BRO_HOME/bin/bro-daemon" ensure >/dev/null 2>&1 || true
  fi
  # No watch loop: nothing here captures the pane on a timer. Bro reads the
  # pane at the moment it acts (bro-snapshot / tmux capture-pane), on demand.
  start_status_loop
  start_nudge_loop
  start_bro_bar
  if ! "${TMUXC[@]}" has-session -t "$SESSION" 2>/dev/null; then
    create_session
  fi
}

create_session() {
  # Window "you": full work surface
  "${TMUXC[@]}" new-session -d -s "$SESSION" -n you \
    "export BRO_HOME='$BRO_HOME'; export BRO_SESSION='$SESSION'; export BRO_TMUX_SOCKET='$BRO_TMUX_SOCKET'; cd '${BRO_START_DIR:-$HOME}'; exec ${SHELL:-/bin/zsh} -i"

  # Window "me": bro (hidden until you call it up)
  "${TMUXC[@]}" new-window -t "$SESSION" -n me \
    "export BRO_HOME='$BRO_HOME'; export BRO_SESSION='$SESSION'; export BRO_TMUX_SOCKET='$BRO_TMUX_SOCKET'; exec '$BRO_HOME/bin/bro-shell' window"

  "${TMUXC[@]}" select-window -t "$SESSION:you"

  # First snapshot
  sleep 0.3
  "$BRO_HOME/bin/bro-snapshot" || true

  "${TMUXC[@]}" display-message -t "$SESSION" 'bro ready — Ctrl-a p shows me, Ctrl-a o hides me'
}

# Migrate before any command touches a state path, so `bro stop` on a
# pre-state/ install still finds the pidfiles it has to kill.
mkdir -p "$STATE"
migrate_state

case "$cmd" in
  ""|start|attach)
    # A terminal is a client. It brings the backend up if nobody else has, then
    # attaches; when it detaches or the window is closed, the backend stays.
    backend_up
    exec "${TMUXC[@]}" attach -t "$SESSION"
    ;;
  backend-up)
    # Headless: bring the backend up, attach nothing. What the daemon calls.
    backend_up
    ;;
  daemon)
    shift
    exec "$BRO_HOME/bin/bro-daemon" "${@:-status}"
    ;;
  verify)
    shift
    exec "$BRO_HOME/bin/bro-verify" "${@:-run}"
    ;;
  doctor)
    exec "$BRO_HOME/bin/bro-doctor"
    ;;
  update)
    exec "$BRO_HOME/bin/bro-update"
    ;;
  remember)
    shift
    exec "$BRO_HOME/bin/bro-remember" "$@"
    ;;
  goal)
    shift
    exec "$BRO_HOME/bin/bro-goals" add "$@"
    ;;
  goals)
    exec "$BRO_HOME/bin/bro-goals" show
    ;;
  remind)
    shift
    # A reminder with a WHEN is an add; no args is a listing.
    if [[ $# -ge 2 ]]; then
      exec "$BRO_HOME/bin/bro-remind" add "$@"
    fi
    exec "$BRO_HOME/bin/bro-remind" "${@:-list}"
    ;;
  brief|debrief)
    role="$cmd"
    shift
    case "${1:-}" in
      "")
        { echo "role=$role"; echo ""; echo "Compose my $role now."; } \
          | "$INBOX_TOOL" enqueue ask "$(pwd)" >/dev/null
        echo "$role queued"
        ;;
      off)
        for f in "$BRO_HOME"/reminders/*.md; do
          [[ -e "$f" ]] || continue
          if grep -qx "role=$role" "$f"; then
            "$BRO_HOME/bin/bro-remind" cancel "$(sed -n 's/^id=//p' "$f")" >/dev/null
          fi
        done
        echo "$role schedule off"
        ;;
      *)
        id="$("$BRO_HOME/bin/bro-remind" add --daily --role "$role" "$1" "daily $role")"
        echo "$role scheduled daily at $1 ($id)"
        ;;
    esac
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  --backend)
    export BRO_BACKEND="${2:-}"
    if [[ -z "$BRO_BACKEND" ]]; then
      echo "usage: bro --backend grok|claude|codex" >&2
      exit 2
    fi
    echo "$BRO_BACKEND" >"$STATE/backend"
    exec env BRO_BACKEND="$BRO_BACKEND" "$0" start
    ;;
  backend)
    if [[ -n "${2:-}" ]]; then
      mkdir -p "$STATE"
      echo "$2" >"$STATE/backend"
      echo "backend set to $2"
    else
      if [[ -f "$STATE/backend" ]]; then
        echo "backend: $(cat "$STATE/backend")"
      else
        echo "backend: ${BRO_BACKEND:-grok} (default)"
      fi
    fi
    ;;
  board)
    # The nvim board: editing and scrollback, inside the session. The floating
    # panel (F1) is the everyday answer surface; this is the one you can scroll
    # and search.
    exec "$BRO_HOME/bin/bro-show" --board
    ;;
  show)
    shift
    exec "$BRO_HOME/bin/bro-show" "${@:---toggle}"
    ;;
  snapshot)
    ensure_dirs
    "$BRO_HOME/bin/bro-snapshot"
    echo "Wrote $WATCH/latest.md"
    ;;
  read)
    # Look now, then print. There is no timer keeping latest.md warm, so
    # reading means capturing first — that is the whole point of Phase 5.
    ensure_dirs
    "$BRO_HOME/bin/bro-snapshot" >/dev/null 2>&1 || true
    if [[ -f "$WATCH/latest.md" ]]; then
      cat "$WATCH/latest.md"
    else
      echo "Nothing to read: no bro pane to capture (start with: bro)"
      exit 1
    fi
    ;;
  stop)
    stop_daemon
    stop_loops
    stop_bro_bar
    "${TMUXC[@]}" kill-session -t "$SESSION" 2>/dev/null || true
    "${TMUXC[@]}" kill-session -t bro-popup 2>/dev/null || true
    echo "bro session stopped."
    ;;
  status|mode)
    if [[ -f "$MODE_FILE" ]]; then
      echo "mode: $(cat "$MODE_FILE")"
    else
      echo "mode: call (default)"
    fi
    ;;
  speakers)
    shift
    exec "$BRO_HOME/bin/bro-speakers" "$@"
    ;;
  summon)
    # The same path the global hotkeys take (⌥§ voice, ⌃§ text), reachable from
    # a terminal so it can be tried without pressing anything.
    shift
    if [[ "${1:-}" == "voice" ]]; then
      exec "$BRO_HOME/bin/bro-summon" voice
    fi
    exec "$BRO_HOME/bin/bro-summon" text "$@"
    ;;
  hotkeys)
    exec "$BRO_HOME/bin/bro-hotkeys"
    ;;
  quiet|call|ping)
    echo "$cmd" >"$MODE_FILE"
    {
      echo "mode=$cmd"
    } | "$INBOX_TOOL" enqueue mode "$(pwd)" >/dev/null
    case "$cmd" in
      call)  echo "call  — voice, keep going" ;;
      ping)  echo "ping  — one voice reply, then silent" ;;
      quiet) echo "quiet — no voice, answers on F1" ;;
    esac
    ;;
  ask)
    shift
    if [[ $# -eq 0 ]]; then
      echo "usage: bro ask <message>" >&2
      exit 2
    fi
    {
      echo "$*"
    } | "$INBOX_TOOL" enqueue ask "$(pwd)" >/dev/null
    echo "sent"
    ;;
  *)
    {
      echo "$*"
    } | "$INBOX_TOOL" enqueue ask "$(pwd)" >/dev/null
    echo "sent"
    ;;
esac
