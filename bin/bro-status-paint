#!/usr/bin/env bash
# Paint ~/.bro/status-line once. Used by bro-status and the animator.
set -euo pipefail
BRO_HOME="${BRO_HOME:-$HOME/.bro}"
STATE="${BRO_STATE_DIR:-$BRO_HOME/state}"
WORD="$STATE/status-word"
LINE="$STATE/status-line"
FRAME="$STATE/status-frame"

word="$(tr -d '[:space:]' 2>/dev/null <"$WORD" || echo ready)"
mode="$(tr -d '[:space:]' 2>/dev/null <"$STATE/mode" || echo call)"
n="$(tr -d '[:space:]' 2>/dev/null <"$FRAME" || echo 0)"
[[ "$n" =~ ^[0-9]+$ ]] || n=0

spiners='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
pulse='●○●○●○●○●○'
waves='▁▂▃▄▃▂▁▂▃▄'

idx=$((n % 10))
spin="${spiners:$idx:1}"
dot="${pulse:$idx:1}"
wave="${waves:$idx:1}"

prefix=""
if [[ "$mode" == "quiet" ]]; then
  prefix="quiet "
elif [[ "$mode" == "ping" ]]; then
  prefix="ping "
fi

case "$word" in
  starting)
    color='#e5c07b'; mark="$spin"; label='starting' ;;
  working)
    color='#e5c07b'; mark="$spin"; label='working' ;;
  speaking)
    color='#c678dd'; mark="$wave"; label='speaking' ;;
  listening)
    color='#61afef'; mark="$dot"; label='listening' ;;
  down)
    color='#e06c75'; mark=''; label='down' ;;
  login)
    color='#e39b3b'; mark=''; label='login' ;;
  nudge)
    color='#d19a66'; mark=''; label='nudge' ;;
  ready)
    color='#7dcea0'; mark=''; label='ready' ;;
  *)
    color='#aaaaaa'; mark=''; label="$word" ;;
esac

if [[ -n "$mark" ]]; then
  printf '#[fg=%s]%s%s %s' "$color" "$prefix" "$mark" "$label" >"$LINE"
else
  printf '#[fg=%s]%s%s' "$color" "$prefix" "$label" >"$LINE"
fi
